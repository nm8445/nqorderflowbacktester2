*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Claude Code memory
.claude/

# farm runtime state (rebuilt from NT8 + persisted bookkeeping)
live/farm/state/

