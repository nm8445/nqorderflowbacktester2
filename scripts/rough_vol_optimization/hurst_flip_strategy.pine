// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Rough Vol + Hurst Flip Strategy
// Normal entries H<0.56 | Flipped entries H>=0.60 | 30-day rolling R/S Hurst
// SL 1.5x / TP 2.5x ATR(14) | Session 09:30-15:30 ET | EMA(50) filter

//@version=5
strategy("Rough Vol Hurst Flip", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1,
         calc_on_every_tick=false, process_orders_on_close=true, margin_long=100, margin_short=100)

// ─── INPUTS ───
grpSignal = "Signal Parameters"
i_H          = input.float(0.40, "Kernel H", step=0.05, group=grpSignal)
i_kernelLen  = input.int(80, "Kernel Length", group=grpSignal)
i_normLen    = input.int(250, "Norm Length", group=grpSignal)
i_zLookback  = input.int(100, "Z Lookback", group=grpSignal)
i_highZ      = input.float(1.5, "High Z Threshold", step=0.1, group=grpSignal)
i_lowZ       = input.float(-1.0, "Low Z Threshold", step=0.1, group=grpSignal)
i_emaLen     = input.int(50, "EMA Length", group=grpSignal)

grpHurst = "Hurst Regime Filter"
i_hurstWindow = input.int(30, "Hurst Window (days)", group=grpHurst)
i_hurstNormal = input.float(0.56, "Normal Max H", step=0.01, group=grpHurst)
i_hurstFlip   = input.float(0.60, "Flip Min H", step=0.01, group=grpHurst)
i_minChunk    = input.int(8, "Min Chunk Size (R/S)", group=grpHurst)

grpRisk = "Risk Management"
i_atrLen  = input.int(14, "ATR Length", group=grpRisk)
i_slMult  = input.float(1.5, "SL ATR Multiple", step=0.1, group=grpRisk)
i_tpMult  = input.float(2.5, "TP ATR Multiple", step=0.1, group=grpRisk)
i_maxDay  = input.int(5, "Max Trades/Day", group=grpRisk)

grpSession = "Session"
i_sessStart  = input.session("0930-1530", "Entry Session (ET)", group=grpSession)
i_forceClose = input.int(1527, "Force Close (HHMM ET)", group=grpSession)

// ─── SESSION DETECTION ───
// Convert current bar time to ET
isInSession = not na(time(timeframe.period, i_sessStart, "America/New_York"))
currentTimeET = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
isPastForceClose = currentTimeET >= i_forceClose

// ─── ROUGH VOL Z-SCORE ───
logRet = math.log(close / close[1])
meanRet = ta.sma(logRet, i_normLen)
// Pine ta.stdev is population std when biased=true (ddof=0 equivalent)
stdRet = ta.stdev(logRet, i_normLen, true)

shock = stdRet > 0 ? (logRet - meanRet) / stdRet : 0.0

// Fractional kernel convolution
// kernel[k] = k^(H-0.5) - (k-1)^(H-0.5) for k=1..KERNEL_LEN, kernel[0]=1
var float xH = 0.0
float xH_sum = 0.0
exp_val = i_H - 0.5
for k = 1 to i_kernelLen
    float kf = float(k)
    float kern_k = k == 1 ? 1.0 : math.pow(kf, exp_val) - math.pow(kf - 1.0, exp_val)
    xH_sum += nz(shock[k-1]) * kern_k
xH := xH_sum

// Variance model
float eta = 1.0
float v0 = 0.0001
float v_model = math.min(v0 * math.exp(eta * xH), v0 * 1e4)

// Z-score of variance
v_mean = ta.sma(v_model, i_zLookback)
v_std = ta.stdev(v_model, i_zLookback, true)  // population std (ddof=0)
z_vol = v_std > 0 ? (v_model - v_mean) / v_std : 0.0

// ─── EMA FILTER ───
emaVal = ta.ema(close, i_emaLen)

// ─── ATR (RMA) ───
atrVal = ta.atr(i_atrLen)

// ─── HURST EXPONENT (R/S METHOD) ───
// Compute on daily reset (once per day at session start)
// Uses session bars only (when isInSession)

// Count session bars per day
var int sessionBarsToday = 0
var int prevDay = -1
currentDay = dayofmonth(time, "America/New_York")
if currentDay != prevDay
    sessionBarsToday := 0
    prevDay := currentDay
if isInSession
    sessionBarsToday += 1

// We need ~720 session bars for 30-day window (30 days * ~24 bars/day)
// Store session log returns in array — skip first bar of each session (gap return)
var float[] sessReturns = array.new_float(0)
int maxBars = i_hurstWindow * 26  // slightly oversize for safety

if isInSession and sessionBarsToday > 1 and not na(logRet)
    array.push(sessReturns, logRet)
    if array.size(sessReturns) > maxBars
        array.shift(sessReturns)

// Compute Hurst once per day (on first session bar)
var float dailyHurst = na

if isInSession and sessionBarsToday == 1
    int n_ret = array.size(sessReturns)
    if n_ret >= 50
        // Build chunk sizes: start at minChunk, multiply by 1.5 until n/2
        var float[] logNs = array.new_float(0)
        var float[] logRs = array.new_float(0)
        array.clear(logNs)
        array.clear(logRs)

        int cs = i_minChunk
        while cs <= n_ret / 2
            int n_chunks = n_ret / cs
            if n_chunks >= 1
                float rs_sum = 0.0
                int rs_count = 0
                for c = 0 to n_chunks - 1
                    // Compute mean of chunk
                    float chunk_mean = 0.0
                    for j = 0 to cs - 1
                        chunk_mean += array.get(sessReturns, c * cs + j)
                    chunk_mean := chunk_mean / cs

                    // Cumulative deviation, range, and std
                    float cum_dev = 0.0
                    float max_cum = -1e18
                    float min_cum = 1e18
                    float sum_sq = 0.0
                    for j = 0 to cs - 1
                        float val = array.get(sessReturns, c * cs + j)
                        float dev = val - chunk_mean
                        cum_dev += dev
                        max_cum := math.max(max_cum, cum_dev)
                        min_cum := math.min(min_cum, cum_dev)
                        sum_sq += dev * dev

                    float range_val = max_cum - min_cum
                    float sd = math.sqrt(sum_sq / (cs - 1))
                    if sd > 0
                        rs_sum += range_val / sd
                        rs_count += 1

                if rs_count > 0
                    array.push(logNs, math.log(cs))
                    array.push(logRs, math.log(rs_sum / rs_count))

            int prev_cs = cs
            cs := int(math.round(cs * 1.5))
            if cs <= prev_cs
                cs := prev_cs + 1

        // Linear regression on log-log to get Hurst exponent
        int nPts = array.size(logNs)
        if nPts >= 3
            float sumX = 0.0
            float sumY = 0.0
            float sumXY = 0.0
            float sumX2 = 0.0
            for p = 0 to nPts - 1
                float x = array.get(logNs, p)
                float y = array.get(logRs, p)
                sumX += x
                sumY += y
                sumXY += x * y
                sumX2 += x * x
            float denom = nPts * sumX2 - sumX * sumX
            if denom != 0
                dailyHurst := (nPts * sumXY - sumX * sumY) / denom
            else
                dailyHurst := na
        else
            dailyHurst := na
    else
        dailyHurst := na

// ─── TRADE LOGIC ───
var int tradesToday = 0
var int tradeDay = -1
if currentDay != tradeDay
    tradesToday := 0
    tradeDay := currentDay

// Determine regime
bool isNormal = not na(dailyHurst) and dailyHurst < i_hurstNormal
bool isFlip = not na(dailyHurst) and dailyHurst >= i_hurstFlip
bool canTrade = (isNormal or isFlip) and isInSession and not isPastForceClose and tradesToday < i_maxDay

// Generate raw signal
int rawSignal = 0  // 1=long, -1=short, 0=none
if z_vol > i_highZ and close > emaVal
    rawSignal := 1
else if z_vol > i_highZ and close < emaVal
    rawSignal := -1
else if z_vol < i_lowZ and close < emaVal
    rawSignal := 1
else if z_vol < i_lowZ and close > emaVal
    rawSignal := -1

// Apply flip
int finalSignal = rawSignal
if isFlip and rawSignal != 0
    finalSignal := -rawSignal

// Entry
if canTrade and strategy.position_size == 0 and finalSignal != 0
    if finalSignal == 1
        float sl = close - i_slMult * atrVal
        float tp = close + i_tpMult * atrVal
        strategy.entry("Long", strategy.long)
        strategy.exit("Long Exit", "Long", stop=sl, limit=tp)
        tradesToday += 1
    else if finalSignal == -1
        float sl = close + i_slMult * atrVal
        float tp = close - i_tpMult * atrVal
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", "Short", stop=sl, limit=tp)
        tradesToday += 1

// Force close at 15:27 ET
if strategy.position_size != 0 and isPastForceClose
    strategy.close_all("Force Close")

// Close if outside session (safety)
if strategy.position_size != 0 and not isInSession and isPastForceClose
    strategy.close_all("Session End")

// ─── PLOTS ───
plot(emaVal, "EMA", color=color.yellow, linewidth=1)
plot(z_vol, "z_vol", color=color.new(color.cyan, 0), display=display.data_window)
plot(dailyHurst, "Hurst", color=color.new(color.purple, 0), display=display.data_window)

// Background color for regime
bgcolor(isNormal ? color.new(color.green, 93) : isFlip ? color.new(color.red, 93) : na)

// Hurst value on chart
var label hurstLabel = na
if barstate.islast and not na(dailyHurst)
    if not na(hurstLabel)
        label.delete(hurstLabel)
    string regime = dailyHurst < i_hurstNormal ? "NORMAL" : dailyHurst >= i_hurstFlip ? "FLIP" : "SKIP"
    hurstLabel := label.new(bar_index, high,
         "H=" + str.tostring(dailyHurst, "#.###") + " [" + regime + "]",
         style=label.style_label_down, color=color.new(color.purple, 20), textcolor=color.white)

// ─── ALERTS ───
alertcondition(canTrade and strategy.position_size == 0 and finalSignal == 1, "Long Signal", "Hurst Flip: LONG")
alertcondition(canTrade and strategy.position_size == 0 and finalSignal == -1, "Short Signal", "Hurst Flip: SHORT")
