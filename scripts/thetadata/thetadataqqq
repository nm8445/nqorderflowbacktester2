"""
ThetaData QQQ options downloader for gamma-level backtesting (v3 API).

Pulls the data needed to compute MenthorQ-style gamma levels:
  - Call Resistance, Put Support, HVL/Gamma Flip, GEX 1-10
  - Both EOD (one snapshot at 17:15 ET) and intraday (every 30 min)

Prerequisites:
  1. Java 21+ installed
  2. ThetaTerminalv3.jar downloaded and creds.txt next to it
  3. Terminal running:  java -jar ThetaTerminalv3.jar
  4. pip install httpx pandas

v3 API improvements we lean on:
  - expiration=* wildcard pulls every expiration in one call
  - Single response (no pagination)
  - ndjson format streams cleanly into pandas
  - Greeks include underlying price per row
"""

from __future__ import annotations

import datetime as dt
import io
from dataclasses import dataclass

import httpx
import pandas as pd

# v3 uses port 25503 (v2 used 25510)
BASE_URL = "http://127.0.0.1:25503/v3"
HTTP_TIMEOUT = 120.0  # bulk wildcard requests can be large

# MenthorQ-style snapshot times: 8am pre-market + every 30 min from 9:50
INTRADAY_SNAPSHOT_TIMES = [
    "08:00", "09:50", "10:20", "10:50", "11:20", "11:50",
    "12:20", "12:50", "13:20", "13:50", "14:20", "14:50",
    "15:20", "15:50",
]


# ------------------------------ HTTP helpers ------------------------------

def _get_ndjson(path: str, params: dict) -> pd.DataFrame:
    """Hit a v3 endpoint with format=ndjson and return a DataFrame."""
    p = {**params, "format": "ndjson"}
    url = f"{BASE_URL}{path}"
    r = httpx.get(url, params=p, timeout=HTTP_TIMEOUT)
    r.raise_for_status()
    if not r.text.strip():
        return pd.DataFrame()
    return pd.read_json(io.StringIO(r.text), lines=True)


# ------------------------------ List endpoints ------------------------------

def list_expirations(symbol: str = "QQQ") -> list[dt.date]:
    """All available expiration dates for a symbol, as date objects.
    v3 returns them as ISO strings ('2026-04-24'); we parse to dt.date."""
    df = _get_ndjson("/option/list/expirations", {"symbol": symbol})
    if df.empty or "expiration" not in df.columns:
        return []
    return pd.to_datetime(df["expiration"]).dt.date.tolist()


def expirations_within(symbol: str, today: dt.date, days: int = 60) -> list[dt.date]:
    """Filter expirations to those within `days` of today."""
    cutoff = today + dt.timedelta(days=days)
    return [e for e in list_expirations(symbol) if today <= e <= cutoff]


# ------------------------------ History endpoints ------------------------------
# In v3, omitting strike/right returns all strikes/rights.
# Setting expiration='*' returns all expirations.
# So one call pulls the entire chain across the curve.

def history_quote(symbol: str, date: dt.date,
                  expiration: str | int = "*",
                  interval: str = "30m") -> pd.DataFrame:
    return _get_ndjson("/option/history/quote", {
        "symbol": symbol, "expiration": expiration,
        "start_date": date.strftime("%Y%m%d"),
        "end_date": date.strftime("%Y%m%d"),
        "interval": interval,
    })


